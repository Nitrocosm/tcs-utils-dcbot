# Copy this file to .env and fill in your Discord bot token.
TOKEN=your-bot-token-here

# Optional — point the bot at a different guild without editing settings.py.
# Leave unset to use the production TARGET_GUILD baked into settings.py.
# TARGET_GUILD=

# Optional — when set (any value), modules/config/__init__.py loads IDs from
# ids_staging.py instead of ids.py. Generate ids_staging.py once with:
#     .venv/Scripts/python scripts/setup_staging.py <guild_id>
# STAGING_IDS=
